@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model BS.Application.ViewModels.AR.ARChallanDetailVM
@{
    Dictionary<string, string> data = ViewBag.Resources;
    //var pageTitle = data[ResourceKeyEnum.AR_CUSTOMER_INDEX_PAGETITLE.ToString()];
    //ViewBag.Title = pageTitle;
    ViewBag.Title = ViewBag.Resources["AR_CHALLAN_INDEX_PAGETITLE"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page Header -->
<div class="d-md-flex d-block align-items-center justify-content-between my-2 page-header-breadcrumb">
    <h1 class="page-title fw-semibold fs-18 mb-0">@ViewBag.Title</h1>
</div>
<!-- Page Header Close -->
<div class="card custom-card">
    <div class="card-header d-flex justify-content-end align-items-center w-100">
        <div class="form-group mb-0 me-3">
            <div class="row align-items-center">
                <div class="col-auto">
                    <label for="status" class="form-label mb-0">Status:</label>
                </div>
                <div class="col-auto">
                    <select class="form-select" style="width:max-content;" id="status">
                        <option value="ac">Active</option>
                        <option value="in">InActive</option>
                        <option value="all">All</option>
                    </select>
                </div>
            </div>
        </div>
        <button type="button" class="btn btn-primary btn-wave" onclick="window.location='@Url.Action("ChallanAddEdit", "Challan")'">Add Challan</button>
        <button type="button" class="btn btn-sm btn-icon btn-primary-light" onclick="ShowSearchModal();"><i class="bi bi-card-list" title="Advanced Search"></i></button>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table id="responsiveDataTable" class="table text-nowrap table-bordered" style="width:100%">
                <thead>
                    <tr>
                        <th scope="col">Challan#</th>
                        @* <th scope="col" style="visibility: hidden;">ChallanID</th> *@
                        <th scope="col">Challan Date</th>
                        <th scope="col">Customer Name</th>
                        <th scope="col">Net Amt</th>
                        <th scope="col">CGST Amt</th>
                        <th scope="col">SGST Amt</th>
                        <th scope="col">IGST Amt</th>
                        <th scope="col">GST Amt</th>
                        <th scope="col">Total</th>
                        @*<th scope="col">
                            <p class="form-label mb-2 mt-2">
                                Action
                                <button type="button" class="btn btn-sm btn-icon btn-primary-light" onclick="ShowSearchModal();"><i class="bi bi-card-list" title="choose an address"></i></button>
                            </p>
                        </th>*@
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal" id="challanSearchModal">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content ">
            <div class="modal-header">
                <h5 class="modal-title" id="searchTitle">Search:</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form>
                <div class="modal-body">
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-sm-6">
                                <label for="CustomerID" class="form-label">Customer Name</label>
                                <select class="form-control" data-trigger name="CustomerID" id="CustomerID" asp-items="@ViewBag.Customers as List<SelectListItem>">
                                    <option value="">Select Customer</option>
                                </select>
                                @*<input type="text" class="form-control" id="billContactName" name="billContactName" placeholder="Contact Name"> *@
                            </div>
                            <div class="col-sm-6">
                                <label for="ChallanNo" class="form-label">Challan No.</label>
                                <input type="text" class="form-control" id="ChallanNo" name="ChallanNo" placeholder="Challan No." value="">
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-6">
                                <label for="Challanfromdate" class="form-label">Challan From Date</label>
                                <input type="text" class="form-control form-control-light" id="Challanfromdate" name="Challanfromdate" placeholder="Choose date">
                            </div>
                            <div class="col-sm-6">
                                <label for="Challantodate" class="form-label">Challan To Date</label>
                                <input type="text" class="form-control form-control-light" id="Challantodate" name="Challantodate" placeholder="Choose date">
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-6">
                                <label for="Challanfromamt" class="form-label">Challan From Amt</label>
                                <input class="form-control form-control-sm form-control-light" id="Challanfromamt" name="Challanfromamt" type="number" min="0" value="">
                            </div>
                            <div class="col-sm-6">
                                <label for="Challantoamt" class="form-label">Challan To Amt</label>
                                <input class="form-control form-control-sm form-control-light" id="Challantoamt" name="Challantoamt" type="number" min="0" value="">
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-6">
                                <label for="itemId1" class="form-label">Product Name</label>
                                @* <select class="form-control" name="itemId1" id="itemId1" asp-items="@ViewBag.Products as List<SelectListItem>">
                                    <option value="0">Select Product</option>
                                </select> *@
                                <select class="form-control" data-trigger name="itemId1" id="itemId1" asp-items="@ViewBag.Products as List<SelectListItem>">
                                    <option value="">Select Product</option>
                                </select>
                            </div>
                            <div class="col-sm-6">
                                @* <label for="billWhatsappPhone" class="form-label">WhatsApp Phone</label>
                                <input type="tel" class="form-control" id="billWhatsappPhone" name="billWhatsappPhone" placeholder="+123-456-7890"> *@
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer justify-content-center">
                    <button id="searchchallan" class="btn btn-primary" type="button">
                        <!----> Search
                    </button>
                    <button type="button" class="btn btn-secondary" data-dismiss="modal" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>

</div>


<!-- Internal Datatables JS -->
@* <script src="~/bs/js/datatables.js"></script> *@

<style>
    .custom-card-header {
        background-color: #a3aed1 !important;
    }

    .table-header {
        background-color: var(--default-body-bg-color);
    }

    .custom-header-control {
        display: flex;
        align-items: center;
    }

    /* Add spacing between elements if needed */
    .form-label, .form-select, .btn {
        margin-right: 10px; /* Adjust the margin as needed */
    }

    .flatpickr-calendar {
        z-index: 9999 !important;
    }

</style>

@section Scripts {
    <script src="~/bs/js/ar_challanlist.js" asp-append-version="true"></script>

}
